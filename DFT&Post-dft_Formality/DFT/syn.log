####################################################################################
# Constraints
# ----------------------------------------------------------------------------
#
# 0. Design Compiler variables
#
# 1. Master Clock Definitions
#
# 2. Generated Clock Definitions
#
# 3. Clock Uncertainties
#
# 4. Clock Latencies 
#
# 5. Clock Relationships
#
# 6. #set input/output delay on ports
#
# 7. Driving cells
#
# 8. Output load
####################################################################################
#########################################################
#### Section 0 : DC Variables ####
#########################################################
#################################################################################### 
# Prevent assign statements in the generated netlist (must be applied before compile command)
set_fix_multiple_port_nets -all -buffer_constants -feedthroughs
####################################################################################
#########################################################
#### Section 1 : Clock Definition ####
#########################################################
#################################################################################### 
# 1. Master Clock Definitions 
# 2. Generated Clock Definitions
# 3. Clock Latencies
# 4. Clock Uncertainties
# 4. Clock Transitions
####################################################################################
#1. Master Clocks
set CLK1_NAME REF_CLK
set CLK1_PER 20
set CLK1_HALF_PER [expr $CLK1_PER/2]
set CLK2_NAME UART_CLK
set CLK2_PER 271.267
set CLK2_HALF_PER [expr $CLK2_PER/2]
# DFT
set CLK3_NAME SCAN_CLK
set CLK3_PER 100
set CLK3_HALF_PER [expr $CLK3_PER/2]
# Skew
set CLK_SETUP_SKEW 0.2
set CLK_HOLD_SKEW  0.1
# Transition 
set CLK_TRANSITION 0.05
# master clocks 
create_clock -name $CLK1_NAME -period $CLK1_PER -waveform "0 $CLK1_HALF_PER" [get_ports REF_CLK]
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks $CLK1_NAME]
set_clock_uncertainty -hold  $CLK_HOLD_SKEW  [get_clocks $CLK1_NAME]
set_clock_transition  $CLK_TRANSITION       [get_clocks $CLK1_NAME]
create_clock -name $CLK2_NAME -period $CLK2_PER -waveform "0 $CLK2_HALF_PER" [get_ports UART_CLK]
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks $CLK2_NAME]
set_clock_uncertainty -hold  $CLK_HOLD_SKEW  [get_clocks $CLK2_NAME]
set_clock_transition  $CLK_TRANSITION       [get_clocks $CLK2_NAME]
# Scan clock 
create_clock -name $CLK3_NAME -period $CLK3_PER -waveform "0 $CLK3_HALF_PER" [get_ports scan_clk]
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks $CLK3_NAME]
set_clock_uncertainty -hold  $CLK_HOLD_SKEW  [get_clocks $CLK3_NAME]
set_clock_transition  $CLK_TRANSITION       [get_clocks $CLK3_NAME]
#2. Generated clock
# UART TX generated clock
create_generated_clock -master_clock $CLK2_NAME -source [get_ports UART_CLK]                        -name "UART_TX_CLK" [get_pins dut_TX_CLOCK_DIVIDER/div_clk]                        -divide_by 32
# UART RX generated clock 
create_generated_clock -master_clock $CLK2_NAME -source [get_ports UART_CLK]                        -name "UART_RX_CLK" [get_pins dut_Clock_Divider_RX/div_clk]                        -divide_by 1
# ALU clock 
create_generated_clock -master_clock $CLK1_NAME -source [get_ports REF_CLK]                        -name "ALU_CLK" [get_pins dut_CLK_GATE/gated_clock]                        -divide_by 1
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks "UART_RX_CLK"]
set_clock_uncertainty -hold  $CLK_HOLD_SKEW   [get_clocks "UART_RX_CLK"]
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks "UART_TX_CLK"]
set_clock_uncertainty -hold  $CLK_HOLD_SKEW   [get_clocks "UART_TX_CLK"]
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks "ALU_CLK"]
set_clock_uncertainty -hold  $CLK_HOLD_SKEW   [get_clocks "ALU_CLK"]
# ---------------- Don't touch networks ---------------------
set_dont_touch_network [get_clocks "$CLK1_NAME $CLK2_NAME $CLK3_NAME UART_TX_CLK UART_RX_CLK  ALU_CLK"]
set_dont_touch_network [get_ports "RST_N"]
####################################################################################
#########################################################
#### Section 2 : Clocks Relationship ####
#########################################################
####################################################################################
set_clock_groups -asynchronous     -group [get_clocks "$CLK1_NAME ALU_CLK"]     -group [get_clocks "$CLK2_NAME UART_TX_CLK UART_RX_CLK"]     -group [get_clocks "$CLK3_NAME"]
####################################################################################
#########################################################
#### Section 3 : #set input/output delay on ports ####
#########################################################
####################################################################################
# I/O delay 
set in_delay  [expr 0.2 * $CLK2_PER]
set out_delay [expr 0.2 * $CLK2_PER]
# scan I/O use 20% of scan clk period
set in_scan_delay  [expr 0.2 * $CLK3_PER]
set out_scan_delay [expr 0.2 * $CLK3_PER]
#  Functional inputs 
set_input_delay $in_delay -clock $CLK2_NAME [get_ports UART_RX_IN]
# Scan  input ports 
set_input_delay $in_scan_delay -clock $CLK3_NAME [get_ports test_mode]
set_input_delay $in_scan_delay -clock $CLK3_NAME [get_ports SI]
set_input_delay $in_scan_delay -clock $CLK3_NAME [get_ports SE]
# Functional outputs
set_output_delay $out_delay -clock UART_TX_CLK [get_ports UART_TX_O]
set_output_delay $out_delay -clock $CLK2_NAME   [get_ports parity_error]
set_output_delay $out_delay -clock $CLK2_NAME   [get_ports framing_error]
# Scan output
set_output_delay $out_scan_delay -clock $CLK3_NAME [get_ports SO]
